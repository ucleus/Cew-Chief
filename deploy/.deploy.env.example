# Hostinger hPanel → Websites → Dashboard → SSH Access
SSH_USER="u123456789"
SSH_HOST="203.0.113.10"
SSH_PORT="65002"

# Exact subdirectory to deploy into. The script refuses paths outside public_html.
REMOTE_PATH="/home/u123456789/domains/example.com/public_html/crew-chief"

# Hostinger CLI PHP command, only needed if you want the script to smoke-test
# the API after deploying. Use this path if the default `php` is older.
PHP_BIN="/opt/alt/php82/usr/bin/php"

# Refuse deployment when this project has uncommitted changes. Set to 0 only deliberately.
REQUIRE_CLEAN_GIT="0"
